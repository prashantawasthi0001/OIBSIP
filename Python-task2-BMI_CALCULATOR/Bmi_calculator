import tkinter as tk
from tkinter import messagebox

def calculate_bmi():
    try:
        weight = float(weight_entry.get())
        height_cm = float(height_entry.get())

        if weight <= 0 or height_cm <= 0:
            raise ValueError

        height_m = height_cm / 100
        bmi = weight / (height_m ** 2)

        if bmi < 18.5:
            category = "Underweight"
            color = "#3498db"
        elif bmi < 25:
            category = "Normal Weight"
            color = "#27ae60"
        elif bmi < 30:
            category = "Overweight"
            color = "#f39c12"
        else:
            category = "Obesity"
            color = "#e74c3c"

        bmi_value.config(text=f"{bmi:.2f}", fg=color)
        result_label.config(text=f"Category: {category}", fg=color)

    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter valid positive numbers for weight and height."
        )

def clear_fields():
    weight_entry.delete(0, tk.END)
    height_entry.delete(0, tk.END)
    bmi_value.config(text="--", fg="#2c3e50")
    result_label.config(text="Enter your details and click Calculate", fg="#555555")

# Main window
root = tk.Tk()
root.title("BMI Calculator")
root.geometry("520x620")
root.resizable(False, False)
root.configure(bg="#eef5ff")

# Header
header = tk.Frame(root, bg="#4a69bd", height=120)
header.pack(fill="x")

title = tk.Label(
    header,
    text="BMI CALCULATOR",
    font=("Arial", 25, "bold"),
    bg="#4a69bd",
    fg="white"
)
title.pack(pady=(25, 5))

subtitle = tk.Label(
    header,
    text="Check your Body Mass Index",
    font=("Arial", 12),
    bg="#4a69bd",
    fg="#dfe6ff"
)
subtitle.pack()

# Input card
card = tk.Frame(root, bg="white", padx=30, pady=25)
card.pack(padx=35, pady=25, fill="x")

tk.Label(
    card, text="Weight (kg)", font=("Arial", 12, "bold"),
    bg="white", fg="#2c3e50"
).pack(anchor="w")

weight_entry = tk.Entry(
    card, font=("Arial", 14), bd=1, relief="solid"
)
weight_entry.pack(fill="x", pady=(6, 18), ipady=7)

tk.Label(
    card, text="Height (cm)", font=("Arial", 12, "bold"),
    bg="white", fg="#2c3e50"
).pack(anchor="w")

height_entry = tk.Entry(
    card, font=("Arial", 14), bd=1, relief="solid"
)
height_entry.pack(fill="x", pady=(6, 20), ipady=7)

# Buttons
button_frame = tk.Frame(card, bg="white")
button_frame.pack(fill="x")

calculate_btn = tk.Button(
    button_frame,
    text="CALCULATE BMI",
    command=calculate_bmi,
    font=("Arial", 11, "bold"),
    bg="#4a69bd",
    fg="white",
    activebackground="#3c5aa6",
    activeforeground="white",
    bd=0,
    cursor="hand2",
    padx=15,
    pady=10
)
calculate_btn.pack(side="left", expand=True, fill="x", padx=(0, 5))

clear_btn = tk.Button(
    button_frame,
    text="CLEAR",
    command=clear_fields,
    font=("Arial", 11, "bold"),
    bg="#e74c3c",
    fg="white",
    activebackground="#c0392b",
    activeforeground="white",
    bd=0,
    cursor="hand2",
    padx=15,
    pady=10
)
clear_btn.pack(side="right", expand=True, fill="x", padx=(5, 0))

# Result card
result_card = tk.Frame(root, bg="white", padx=20, pady=20)
result_card.pack(padx=35, fill="x")

tk.Label(
    result_card,
    text="YOUR BMI",
    font=("Arial", 11, "bold"),
    bg="white",
    fg="#777777"
).pack()

bmi_value = tk.Label(
    result_card,
    text="--",
    font=("Arial", 38, "bold"),
    bg="white",
    fg="#2c3e50"
)
bmi_value.pack(pady=5)

result_label = tk.Label(
    result_card,
    text="Enter your details and click Calculate",
    font=("Arial", 12, "bold"),
    bg="white",
    fg="#555555"
)
result_label.pack()

# Footer
tk.Label(
    root,
    text="BMI = Weight (kg) / Height² (m²)",
    font=("Arial", 10),
    bg="#eef5ff",
    fg="#666666"
).pack(pady=18)

root.mainloop()
